#!/bin/sh
# Run the backup script in AIO mode

set -e

export PATH="/usr/lib/postgresql/16/bin:$PATH"

# Wait for PostgreSQL to be ready
echo "Waiting for PostgreSQL for backup service..."
until pg_isready -h localhost -U igab -d igab -q; do
    sleep 1
done
echo "PostgreSQL is ready, starting backup service."

# Set environment for local postgres connection
export PGHOST=localhost
export PGUSER=igab
export PGPASSWORD=igab
export PGDATABASE=igab

# Run the backup agent — the file-based protocol with the API works inside
# the AIO container too, since both halves share one filesystem.
exec /usr/local/bin/db-backup.sh

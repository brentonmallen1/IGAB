# IGAB Environment Configuration
# Copy to .env and fill in values
#
# For All-in-One deployment (docker-compose.aio.yml), only these are needed:
#   SECRET_KEY, ADMIN_PASSWORD, and optionally WEB_PORT, OLLAMA_HOST
# The database is embedded and configured automatically.

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=igab
DB_PASSWORD=changeme
DB_NAME=igab
DB_PORT=5432
DB_DATA_DIR=./data/postgres
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start unless this is at least 32 characters and
# not one of the example values from this file.
# Generate with: openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Non-rotating refresh token: expiry = hard logout on every device.
# 90 days keeps installed phone apps signed in; rotate SECRET_KEY to revoke all sessions.
REFRESH_TOKEN_EXPIRE_DAYS=90

# ─── Admin User ──────────────────────────────────────────────────────────────
# The admin user is created on first run and its password is re-synced to
# ADMIN_PASSWORD on every start — edit it here and restart to change it.
# REQUIRED — the app refuses to start while ADMIN_PASSWORD is empty or the
# shipped example value ("changeme"). Any other value is accepted; pick a
# strong one, since this login is exposed wherever the app is reachable.
# NOTE: changing ADMIN_EMAIL creates a NEW user (budgets stay with the old
# email) — it does not rename the existing admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── Application ─────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080
# AIO only: single port for the web UI
WEB_PORT=8080
# AIO only: all data in one directory (database, attachments, backups)
DATA_DIR=./data
# Wall clock for the backup agent — backup filenames are stamped with it. Any
# IANA zone name (America/New_York, Europe/Berlin). The app stores UTC and
# renders times in your browser's zone regardless of this setting.
TZ=UTC

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ─── Backups (db-backup container, production profile) ──────────────────────
# The BACKUP_KEEP_*/INTERVAL/AGE_RECIPIENT values below are seeds + fallbacks:
# Settings → Backups in the app overrides them (stored in the database, picked
# up by the agent within seconds). If the database is unreachable the agent
# falls back to these env values.
# Where database dumps + attachment archives land. Point this at a disk that
# is NOT the database's disk (on Unraid: a share on the array, not the same
# pool as DB_DATA_DIR).
BACKUP_DIR=./backups
# Prune backups older than this many days...
BACKUP_KEEP_DAYS=30
# ...but always keep at least this many newest files of each kind, however
# old — a month of silently failing backups must not delete the last good ones.
BACKUP_KEEP_MIN=7
# Hours between backup runs. The first run happens at container start.
BACKUP_INTERVAL_HOURS=24
# Optional: age public key (age1...). When set, dumps and attachment archives
# are encrypted to it (*.age). Generate a keypair with `age-keygen`; keep the
# private key OFF this host. Restore: `just restore <file>.age` with
# BACKUP_AGE_KEY_FILE pointing at the private key.
#BACKUP_AGE_RECIPIENT=

# ─── SimpleFIN ───────────────────────────────────────────────────────────────
# Required for bank sync. This is NOT a SimpleFIN token — you generate it
# yourself and it never leaves this server. It encrypts the access URL that
# SimpleFIN hands back, so a database dump does not contain live bank
# credentials. (The setup token from simplefin.org is pasted into the app, not
# stored here.) Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is NOT the SECRET_KEY recipe: a Fernet key is 32 url-safe base64 bytes,
# so a hex string from `openssl rand -hex 32` is rejected.
# Keep it. Connections are stored encrypted with this key and cannot be read
# with any other — change it and every connection must be removed and re-added.
SIMPLEFIN_ENCRYPTION_KEY=

# ─── Ollama AI (seeds app_settings on first boot, overridable in UI) ─────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional vision-model override for receipt scanning (empty = use OLLAMA_MODEL).
# Also settable in the UI: Settings → AI → "Use a different model for vision tasks"
#OLLAMA_VISION_MODEL=

# ─── SMTP Notifications (env-only, no UI override) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=noreply@igab.local

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Leave VITE_API_URL unset. The app defaults to a relative /api/v1, which works
# from any origin (LAN IP, Tailscale hostname, reverse-proxy domain): the Vite
# dev server proxies /api to the backend (see vite.config.ts), and production
# nginx does the same. Setting an absolute URL here bakes a single host into
# the bundle and breaks access from every other device.
#VITE_API_URL=

# IGAB Environment Configuration
# Copy to .env and fill in values

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=igab
DB_PASSWORD=changeme
DB_NAME=igab
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin User (created on first run) ───────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─── Application ─────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ─── SimpleFIN ───────────────────────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIMPLEFIN_ENCRYPTION_KEY=

# ─── Ollama AI (seeds app_settings on first boot, overridable in UI) ─────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── SMTP Notifications (env-only, no UI override) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=noreply@igab.local

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

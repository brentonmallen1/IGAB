# IGAB web server — rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. ${API_UPSTREAM} is the backend host:port
# (default api:8000, set in the Dockerfile; override for Unraid or any setup
# where the API container isn't reachable as "api").

gzip on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

upstream igab_api {
    server ${API_UPSTREAM};
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;

    # Attachment uploads (backend caps at 20 MB; nginx default of 1m would reject them)
    client_max_body_size 25m;

    # API proxy
    location /api/ {
        proxy_pass http://igab_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets: cache forever
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Workbox runtime is content-hashed like /assets
    location ~ ^/workbox-.*\.js$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Service worker + manifest + entry document must always revalidate,
    # otherwise installed PWAs never see new versions
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        default_type application/manifest+json;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Icons / favicons (stable names, occasionally replaced)
    location ~* \.(png|svg|ico)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }
}
